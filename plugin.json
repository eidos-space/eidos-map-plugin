{
  "apiVersion": 1,
  "requires": {
    "pluginApi": "3.7.0"
  },
  "id": "eidos.map",
  "name": "%plugin.name%",
  "version": "0.4.0",
  "icon": {
    "paths": [
      "M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z",
      "M9 3v15",
      "M15 6v15"
    ]
  },
  "browser": {
    "workers": true,
    "networkOrigins": [
      "https://tiles.openfreemap.org"
    ]
  },
  "views": [
    {
      "id": "map",
      "title": "%views.map.title%",
      "entry": "./src/view.tsx",
      "access": "read",
      "icon": {
        "paths": [
          "M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0",
          "M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
        ]
      },
      "configuration": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "string",
            "title": "%views.map.latitude.title%",
            "default": "",
            "x-field": true
          },
          "longitude": {
            "type": "string",
            "title": "%views.map.longitude.title%",
            "default": "",
            "x-field": true
          },
          "label": {
            "type": "string",
            "title": "%views.map.label.title%",
            "default": "",
            "x-field": true
          },
          "basemap": {
            "type": "string",
            "title": "%views.map.basemap.title%",
            "default": "online",
            "enum": [
              "online",
              "offline"
            ],
            "description": "%views.map.basemap.description%"
          }
        }
      },
      "kind": "file",
      "capabilities": [
        "eidos/table"
      ]
    }
  ],
  "placements": [
    {
      "location": "table/view",
      "view": "map"
    }
  ],
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
