  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"], "noEmit": true
  },
  "include": ["src"]
}
